{
  "name": "minecraft-web-recreation",
  "version": "1.0.0",
  "description": "An independent browser-based first-person voxel survival recreation built with Three.js, Vite and Web Audio.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node tests/run-unit-tests.mjs",
    "test:e2e": "node tests/browser-smoke.mjs",
    "test:ui": "node tests/interface-check.mjs",
    "test:fluids": "node tests/browser-fluids.mjs",
    "test:redstone": "node tests/browser-redstone.mjs",
    "test:chests": "node tests/browser-chests.mjs",
    "test:portals": "node tests/browser-portals.mjs",
    "test:adventure": "node tests/browser-adventure.mjs",
    "test:environment": "node tests/browser-environment.mjs",
    "test:streaming": "node tests/browser-streaming-performance.mjs",
    "test:hostiles": "node tests/browser-hostiles.mjs",
    "test:stress": "node tests/browser-stress.mjs",
    "test:storage": "node tests/browser-storage.mjs",
    "test:performance": "node tests/browser-performance-audit.mjs",
    "verify": "node tests/verify.mjs",
    "check": "npm run test && npm run build",
    "test:all": "npm run verify"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.1"
  }
}
